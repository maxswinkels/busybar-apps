---
interface Props {
  slug: string;
  name: string;
}

const { slug, name } = Astro.props;
---

<button
  type="button"
  class="fav-button"
  data-favorite-slug={slug}
  aria-pressed="false"
  aria-label={`Favorite ${name}`}
>
  <svg class="fav-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M12 21C7.2 17.6 2 13.6 2 8.9 2 5.6 4.4 3.5 7 3.5c1.9 0 3.8 1 5 2.9 1.2-1.9 3.1-2.9 5-2.9 2.6 0 5 2.1 5 5.4 0 4.7-5.2 8.7-10 12.1z"/>
  </svg>
  <span class="fav-count" hidden></span>
</button>

<style>
  .fav-button {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-xs);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 13px;
    padding: var(--sp-xs);
    border-radius: var(--radius-sm);
    position: relative;
    z-index: 1;
    transition: color var(--transition-fast);
    flex-shrink: 0;
  }

  .fav-button:hover {
    color: var(--color-primary);
  }

  .fav-button[aria-pressed="true"] {
    color: var(--color-primary);
  }

  .fav-icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: fill var(--transition-fast);
  }

  .fav-button[aria-pressed="true"] .fav-icon path {
    fill: currentColor;
  }
</style>
