---
import type { CollectionEntry } from 'astro:content';
import FavoriteButton from './FavoriteButton.astro';
import { authorSlug } from '../lib/authors';
import { getAddedDates } from '../lib/added-dates';

interface Props {
  app: CollectionEntry<'apps'>;
  slug: string;
}

const { app, slug } = Astro.props;
const { name, author, description, tags, preview } = app.data;
const baseUrl = import.meta.env.BASE_URL;

// Haystack for the gallery search box: name, author, description and tags.
const search = [name, author, description, ...tags].join(' ').toLowerCase();
const added = (await getAddedDates()).get(slug) ?? '';
---

<article
  class="app-card"
  data-slug={slug}
  data-tags={tags.join(' ')}
  data-search={search}
  data-added={added}
>
  <div class="app-preview">
    <div class="device">
      <img class="device-illu" src={`${baseUrl}brand/busybar-device.png`} alt="" aria-hidden="true" />
      <img class="device-screen" src={preview.src} alt={name} />
    </div>
  </div>
  <div class="app-info">
    <div class="app-title-row">
      <h3 class="app-name"><a class="app-link" href={`${baseUrl}apps/${slug}/`}>{name}</a></h3>
      <FavoriteButton slug={slug} name={name} />
    </div>
    <p class="app-author">
      <a class="app-author-link" href={`${baseUrl}authors/${authorSlug(author)}/`}>@{author}</a>
    </p>
    <p class="app-description">{description}</p>
    <div class="app-tags">
      {tags.map(tag => (
        <span class="app-tag">{tag}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .app-card {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-shadow);
    overflow: hidden;
    transition: box-shadow var(--transition-normal);
    position: relative;
  }

  .app-card[hidden] {
    display: none;
  }

  .app-card:hover {
    box-shadow: inset 0 1px 1px 0 var(--ring-in), 0 0 0 1px var(--color-primary),
      0 18px 40px -24px rgba(0, 0, 0, 0.5);
  }

  .app-preview {
    padding: 24px 20px 12px;
    background: linear-gradient(180deg, #f2f2f4 0%, #fafafa 100%);
  }

  .device {
    position: relative;
    width: 100%;
    margin: 0 auto;
    filter: drop-shadow(0 14px 26px rgba(0, 0, 0, 0.28));
  }

  .device-illu {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .device-screen {
    position: absolute;
    left: 50%;
    top: 56.85%;
    transform: translate(-50%, -50%);
    width: 93.5%;
    height: auto;
    image-rendering: pixelated;
    border-radius: 2px;
  }

  .app-info {
    padding: var(--sp-md);
  }

  .app-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm);
  }

  .app-name {
    margin: 0 0 4px 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
  }

  .app-link {
    color: inherit;
    text-decoration: none;
  }

  .app-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .app-author {
    margin: 0 0 8px 0;
    font-size: 13px;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
  }

  /* Lift the author out from under the card-wide click target of .app-link::after. */
  .app-author-link {
    position: relative;
    z-index: 1;
    color: inherit;
  }

  .app-author-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .app-description {
    margin: 0 0 12px 0;
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .app-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .app-tag {
    display: inline-block;
    font-size: 12px;
    background: #f5f5f7;
    color: var(--color-text-secondary);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
  }
</style>
