---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntryBySlug } from 'astro:content';
import { Code } from 'astro:components';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.id.split('/')[0] },
    props: { app },
  }));
}

interface Props {
  app: any;
}

const { app } = Astro.props;
const { name, author, description, tags, preview } = app.data;
const slug = app.id.split('/')[0];
const baseUrl = import.meta.env.BASE_URL;

// Read the app.py source code
const appPyPath = path.join(
  process.cwd(),
  'apps',
  slug,
  'app.py'
);
const appSource = await readFile(appPyPath, 'utf-8');
---

<Layout title={`${name} · BUSY Bar Apps`}>
  <div class="container">
    <div class="app-detail">
      <div class="app-preview">
        <div class="device">
          <img class="device-illu" src={`${baseUrl}brand/busybar-device.png`} alt="" aria-hidden="true" />
          <img class="device-screen" src={preview.src} alt={name} />
        </div>
      </div>

      <div class="app-header">
        <h1>{name}</h1>
        <p class="app-author">
          by <a href={`https://github.com/${author}`} target="_blank">@{author}</a>
        </p>
      </div>

      <p class="app-description">{description}</p>

      {tags.length > 0 && (
        <div class="app-tags">
          {tags.map(tag => (
            <span class="app-tag">{tag}</span>
          ))}
        </div>
      )}

      <section class="section">
        <h2>How to run</h2>
        <p>
          This app requires the <code>busybar.py</code> client library from the
          <a href="https://github.com/maxswinkels/busybar-emulator" target="_blank">BUSY Bar Emulator</a>.
        </p>
        <div class="code-snippet">
          <pre><code>python app.py &lt;host&gt;</code></pre>
        </div>
        <p>
          For local development, run the emulator first, then execute the app with the emulator's address
          (default <code>127.0.0.1:8080</code>).
        </p>
      </section>

      <section class="section">
        <h2>Source code</h2>
        <div class="code-block">
          <div class="code-header">
            <span class="code-filename">app.py</span>
            <button class="copy-button" id="copy-btn" title="Copy to clipboard">Copy</button>
          </div>
          <Code code={appSource} lang="python" theme="dark-plus" />
        </div>
      </section>

      <section class="section">
        <a href={`https://github.com/maxswinkels/busybar-apps/tree/main/apps/${slug}`} target="_blank" class="view-github">
          View source on GitHub →
        </a>
      </section>

      <div class="nav-links">
        <a href={baseUrl} class="back-link">← Back to gallery</a>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ appSource }}>
  const copyBtn = document.getElementById('copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(appSource).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.textContent = originalText;
        }, 2000);
      });
    });
  }
</script>

<style>
  .app-detail {
    max-width: 900px;
  }

  .app-preview {
    margin-bottom: 32px;
  }

  .device {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    filter: drop-shadow(0 20px 36px rgba(0, 0, 0, 0.3));
  }

  .device-illu {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .device-screen {
    position: absolute;
    left: 50%;
    top: 56.85%;
    transform: translate(-50%, -50%);
    width: 93.5%;
    height: auto;
    image-rendering: pixelated;
    border-radius: 2px;
  }

  .app-header {
    margin-bottom: 24px;
  }

  .app-header h1 {
    margin: 0 0 8px 0;
    font-size: 32px;
  }

  .app-author {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  .app-author a {
    font-family: var(--font-mono);
  }

  .app-description {
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .app-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .app-tag {
    display: inline-block;
    font-size: 12px;
    background: #f5f5f7;
    color: var(--color-text-secondary);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }

  .section {
    margin: 40px 0;
  }

  .section h2 {
    margin-top: 0;
  }

  .code-snippet {
    background: #f5f5f7;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    overflow-x: auto;
  }

  .code-snippet pre,
  .code-snippet code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .code-block {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .code-header {
    background: #1e1e1e;
    border-bottom: 1px solid #333;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .code-filename {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .copy-button {
    background: none;
    border: 1px solid #444;
    color: #888;
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 3px;
    cursor: pointer;
    font-family: var(--font-mono);
    transition: all 0.2s;
  }

  .copy-button:hover {
    border-color: #666;
    color: #bbb;
  }

  .copy-button:active {
    transform: scale(0.98);
  }

  :global(.code-block pre) {
    margin: 0 !important;
    padding: 16px !important;
    background: #1e1e1e !important;
    font-size: 13px !important;
    overflow-x: auto !important;
    border-radius: 0 !important;
  }

  .view-github {
    display: inline-block;
    font-weight: 600;
    color: var(--color-primary);
    transition: all var(--transition-normal);
  }

  .view-github:hover {
    transform: translateX(4px);
  }

  .nav-links {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color var(--transition-normal);
  }

  .back-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .app-header h1 {
      font-size: 24px;
    }

    .code-header {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }
</style>
