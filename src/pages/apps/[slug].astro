---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import { getCollection, getEntryBySlug } from 'astro:content';
import { Code } from 'astro:components';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.id.split('/')[0] },
    props: { app },
  }));
}

interface Props {
  app: any;
}

const { app } = Astro.props;
const { name, author, description, tags, preview, repo } = app.data;
const slug = app.id.split('/')[0];
const baseUrl = import.meta.env.BASE_URL;

// Link to the author's own repo when provided, otherwise the monorepo folder.
const githubUrl = repo ?? `https://github.com/maxswinkels/busybar-apps/tree/main/apps/${slug}`;

// Read the app.py source code
const appPyPath = path.join(
  process.cwd(),
  'apps',
  slug,
  'app.py'
);
const appSource = await readFile(appPyPath, 'utf-8');

// Apps with a requirements.txt need a pip install; everything else is zero-install.
let deps: string[] = [];
try {
  const reqs = await readFile(path.join(process.cwd(), 'apps', slug, 'requirements.txt'), 'utf-8');
  deps = reqs
    .split('\n')
    .map((line) => line.trim())
    .filter((line) => line && !line.startsWith('#'))
    .map((line) => line.split(/[=<>!~[;\s]/)[0]);
} catch {}
---

<Layout title={`${name} · BUSY Bar Apps`} description={description}>
  <div class="container">
    <div class="app-detail">
      <div class="app-preview">
        <div class="device">
          <img class="device-illu" src={`${baseUrl}brand/busybar-device.png`} alt="" aria-hidden="true" />
          <img class="device-screen" src={preview.src} alt={name} />
        </div>
      </div>

      <div class="app-header">
        <div class="app-header-row">
          <h1>{name}</h1>
          <FavoriteButton slug={slug} name={name} />
        </div>
        <p class="app-author">
          by <a href={`https://github.com/${author}`} target="_blank">@{author}</a>
        </p>
      </div>

      <p class="app-description">{description}</p>

      <div class="app-tags">
        {deps.length === 0
          ? <span class="app-tag app-tag--zero">zero-install</span>
          : <span class="app-tag app-tag--deps">pip: {deps.join(', ')}</span>}
        {tags.map(tag => (
          <span class="app-tag">{tag}</span>
        ))}
      </div>

      <section class="section">
        <h2>How to run</h2>
        {deps.length === 0 ? (
          <>
            <p>
              This app is a single Python file that talks directly to the BUSY Bar HTTP API:
              no libraries, no setup. Connect your bar via USB and run:
            </p>
            <div class="code-snippet">
              <pre><code>python app.py</code></pre>
            </div>
          </>
        ) : (
          <>
            <p>
              This app depends on <code>{deps.join(', ')}</code>. Grab the app folder
              from GitHub, install once, then run:
            </p>
            <div class="code-snippet">
              <pre><code>pip install -r requirements.txt&#10;python app.py</code></pre>
            </div>
          </>
        )}
        <p>
          Over USB the bar is always at <code>10.0.4.20</code>. On Wi-Fi, pass the bar's IP
          with <code>--host &lt;address&gt;</code>.
        </p>
        <p>
          No bar at hand? Run the
          <a href="https://github.com/maxswinkels/busybar-emulator" target="_blank">BUSY Bar Emulator</a>
          and point the app at it: <code>python app.py --host 127.0.0.1:8080</code>.
        </p>
      </section>

      <section class="section">
        <h2>Source code</h2>
        <div class="code-block">
          <div class="code-header">
            <span class="code-filename">app.py</span>
            <button class="copy-button" id="copy-btn" title="Copy to clipboard">Copy</button>
          </div>
          <Code code={appSource} lang="python" theme="dark-plus" />
        </div>
      </section>

      <section class="section">
        <a href={githubUrl} target="_blank" class="view-github">
          {repo ? 'View project on GitHub →' : 'View source on GitHub →'}
        </a>
      </section>

      <div class="nav-links">
        <a href={baseUrl} class="back-link">← Back to gallery</a>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ appSource }}>
  const copyBtn = document.getElementById('copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(appSource).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.textContent = originalText;
        }, 2000);
      });
    });
  }
</script>

<script>
  import { initFavorites } from '../../scripts/favorites.js';
  initFavorites();
</script>

<style>
  .app-detail {
    max-width: 900px;
  }

  .app-preview {
    margin-bottom: 32px;
  }

  .device {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    filter: drop-shadow(0 20px 36px rgba(0, 0, 0, 0.3));
  }

  .device-illu {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .device-screen {
    position: absolute;
    left: 50%;
    top: 56.85%;
    transform: translate(-50%, -50%);
    width: 93.5%;
    height: auto;
    image-rendering: pixelated;
    border-radius: 2px;
  }

  .app-header {
    margin-bottom: 24px;
  }

  .app-header-row {
    display: flex;
    align-items: center;
    gap: var(--sp-sm);
    margin-bottom: 8px;
  }

  .app-header-row h1 {
    margin: 0;
    font-size: 32px;
  }

  .app-author {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  .app-author a {
    font-family: var(--font-mono);
  }

  .app-description {
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .app-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .app-tag {
    display: inline-block;
    font-size: 12px;
    background: #f5f5f7;
    color: var(--color-text-secondary);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }

  .app-tag--zero {
    background: #e9f7ef;
    color: #1a7f37;
  }

  .app-tag--deps {
    background: #edf2fd;
    color: #3556c4;
    font-family: var(--font-mono);
  }

  .section {
    margin: 40px 0;
  }

  .section h2 {
    margin-top: 0;
  }

  .code-snippet {
    background: #f5f5f7;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    overflow-x: auto;
  }

  .code-snippet pre,
  .code-snippet code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .code-block {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .code-header {
    background: #1e1e1e;
    border-bottom: 1px solid #333;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .code-filename {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .copy-button {
    background: none;
    border: 1px solid #444;
    color: #888;
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 3px;
    cursor: pointer;
    font-family: var(--font-mono);
    transition: all 0.2s;
  }

  .copy-button:hover {
    border-color: #666;
    color: #bbb;
  }

  .copy-button:active {
    transform: scale(0.98);
  }

  :global(.code-block pre) {
    margin: 0 !important;
    padding: 16px !important;
    background: #1e1e1e !important;
    font-size: 13px !important;
    overflow-x: auto !important;
    border-radius: 0 !important;
  }

  .view-github {
    display: inline-block;
    font-weight: 600;
    color: var(--color-primary);
    transition: all var(--transition-normal);
  }

  .view-github:hover {
    transform: translateX(4px);
  }

  .nav-links {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color var(--transition-normal);
  }

  .back-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .app-header h1 {
      font-size: 24px;
    }

    .code-header {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }
</style>
