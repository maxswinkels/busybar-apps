---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="logo">
          <img src={`${baseUrl}brand/logo.svg`} alt="BUSY" class="logo-img" />
          <span class="logo-text">Bar Apps</span>
        </div>
        <nav class="nav">
          <a href={baseUrl} class="nav-link">Apps</a>
          <a href="https://github.com/maxswinkels/busybar-apps/blob/main/CONTRIBUTING.md" target="_blank" class="nav-link">Submit an app</a>
          <a href="https://github.com/maxswinkels/busybar-emulator" target="_blank" class="nav-link">Emulator</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-text">
          Unofficial community project. BUSY Bar is a trademark of Flipper Devices Inc.
          Not affiliated with or endorsed by Flipper Devices.
        </p>
        <p class="footer-links">
          <a href="https://github.com/maxswinkels/busybar-apps" target="_blank">GitHub Repository</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    padding: 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  :global(a) {
    color: var(--color-primary);
    text-decoration: none;
  }

  :global(a:hover) {
    text-decoration: underline;
  }

  :global(h1, h2, h3) {
    margin-top: 0;
    font-weight: 600;
    line-height: 1.2;
  }

  :global(h1) {
    font-size: 28px;
  }

  :global(h2) {
    font-size: 20px;
    margin-top: 24px;
  }

  .site-header {
    background: white;
    border-bottom: 1px solid var(--color-border);
    padding: 16px 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .site-header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .logo-img {
    height: 28px;
    display: block;
  }

  .logo-text {
    color: var(--color-text);
  }

  .nav {
    display: flex;
    gap: 24px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .site-main {
    flex: 1;
  }

  .site-footer {
    margin-top: 48px;
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
    background: #fafafa;
    color: var(--color-text-secondary);
    font-size: 13px;
  }

  .footer-text {
    margin: 0 0 12px 0;
  }

  .footer-links {
    margin: 0;
  }

  .footer-links a {
    color: var(--color-text-secondary);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }
</style>
