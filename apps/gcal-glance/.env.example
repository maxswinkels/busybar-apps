# Google Calendar Glance configuration
# Replace with your secret iCal address from Google Calendar Settings -> Integrate calendar
GCAL_GLANCE_ICAL_URL=https://calendar.google.com/calendar/ical/your_email%40gmail.com/private-xxxxxx/basic.ics

# Optional overrides:
# GCAL_GLANCE_HOST=10.0.4.20
# GCAL_GLANCE_DEMO=false
# GCAL_GLANCE_LOOKAHEAD_COUNT=6
# GCAL_GLANCE_CALENDAR_POLL_INTERVAL_SECONDS=120
# GCAL_GLANCE_ALERT_BANNER_DURATION_SECONDS=15
# GCAL_GLANCE_UPCOMING_ALERT_SEQUENCE_MINUTES=15,5,2,0
